@model ApexOMS_Web.Models.User

<div class="container mt-5">
    <div class="card shadow-lg border-0 mx-auto" style="max-width: 900px;">
        <div class="card-header bg-dark text-white p-4">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-badge fs-2 me-3"></i>
                <div>
                    <h4 class="mb-0">User Profile Management</h4>
                    <small class="text-muted text-light">View and update your account information</small>
                </div>
            </div>
        </div>
        <div class="card-body p-5">
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success border-0 shadow-sm mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.Message
                </div>
            }

            <form asp-action="Profile" method="post" enctype="multipart/form-data">
                <!-- Keep sl hidden for database tracking -->
                <input type="hidden" asp-for="sl" />

                <div class="row g-5">
                    <!-- Photo Column -->
                    <div class="col-md-4 text-center border-end">
                        @* <div class="mb-4">
                            <img id="imgPreview"
                                 src="@(string.IsNullOrEmpty(Model.image_path) ? "/images/default-user.png" : Model.image_path)"
                                 class="rounded-circle border p-1 shadow"
                                 style="width: 180px; height: 180px; object-fit: cover;" />
                        </div> *@
                        <div class="px-3">
                            <label class="form-label fw-bold small text-uppercase">Change Photo</label>
                            <input type="file" name="profilePic" class="form-control form-control-sm" accept="image/*" onchange="showPreview(event)" />
                        </div>
                    </div>

                    <!-- Data Column -->
                    <div class="col-md-8">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">User ID</label>
                                <input asp-for="user_id" class="form-control bg-light" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Current Role</label>
                                <input asp-for="Role" class="form-control bg-light" readonly />
                            </div>
                            <div class="col-12">
                                <hr />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Full Name</label>
                                <input asp-for="user_name" class="form-control" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Email Address</label>
                                <input asp-for="user_email" class="form-control" type="email" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Change Password</label>
                                <input asp-for="user_pass" class="form-control" type="password" placeholder="Enter new password to change" value="" />
                                <small class="text-muted">Leave empty to keep your existing password.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-end mt-5 pt-4 border-top">
                    <button type="submit" class="btn btn-dark px-5 fw-bold shadow">
                        <i class="bi bi-save2 me-2"></i> Save Profile Changes
                    </button>
                    <a href="/Home/Index" class="btn btn-outline-secondary px-4">Back to Home</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showPreview(event) {
            if(event.target.files.length > 0){
                var src = URL.createObjectURL(event.target.files[0]);
                document.getElementById("imgPreview").src = src;
            }
        }
    </script>
}