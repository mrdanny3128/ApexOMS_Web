@model ApexOMS_Web.Models.ArticleLast

<div class="container mt-4">
    <div class="card shadow border-0">
       
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <!-- Use the unique serial number as the primary key -->
                <input type="hidden" asp-for="id" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Sales Part</label>
                        <input asp-for="apex_sales_part" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Last</label>
                        <input asp-for="Last" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Style</label>
                        <input asp-for="shoe_style" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Gender</label>
                        <select asp-for="gender" class="form-select">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Unisex">Unisex</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Season</label>
                        <input asp-for="season" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Season Year</label>
                        <input asp-for="season_year" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Status</label>
                        <select asp-for="status" class="form-select">
                            <option value="1">Available</option>
                            <option value="0">Unavailable</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Entry Date</label>
                        <input asp-for="entry_date" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-warning px-5 fw-bold">Update Article</button>
                    <a href="/Article/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>